GO_VERSION=1.27.3

DATABASE_PATH=/app/data/voxhold.db
MIGRATIONS_PATH=/app/migrations

RESET_DATABASE=false

# Used only once when a fresh database is initialized.
INSTANCE_NAME=Voxhold
BOOTSTRAP_USERNAME=owner
# Leave empty to generate a secure password in bootstrap container logs.
BOOTSTRAP_PASSWORD=

HTTP_PORT=8080
# Address inside the container. Keep 0.0.0.0 when using a reverse proxy.
HTTP_LISTEN_ADDRESS=0.0.0.0
# Host address for Docker port publishing. Local HTTP stays on loopback;
# use the production deploy repository for a public TLS endpoint.
HTTP_BIND_ADDRESS=127.0.0.1

# Keep false unless the app is reachable only through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
HTTP_RATE_LIMIT_RPS=25
HTTP_RATE_LIMIT_BURST=50
HTTP_WRITE_RATE_LIMIT_RPS=8
HTTP_WRITE_RATE_LIMIT_BURST=16
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
INVITE_RATE_LIMIT_PER_MINUTE=20
INVITE_RATE_LIMIT_BURST=10
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=20
WS_CONNECT_RATE_PER_MINUTE=10
WS_CONNECT_RATE_BURST=5
WS_EVENT_RATE_PER_SECOND=30
WS_EVENT_RATE_BURST=60
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_CONNECTIONS_PER_USER=5
RATE_LIMIT_MAX_ENTRIES=20000

# Use 127.0.0.1 for a browser on the same machine.
# Replace it with the server public IP on a VPS.
WEBRTC_PUBLIC_IP=127.0.0.1
WEBRTC_UDP_PORT=50000
WEBRTC_MAX_PARTICIPANTS=32
WEBRTC_MAX_AUDIO_BITRATE_KBPS=128

# Screen sharing uses a separate UDP socket so video load cannot block voice.
WEBRTC_STREAM_UDP_PORT=50001
WEBRTC_STREAM_MAX_VIEWERS=32
WEBRTC_STREAM_MAX_P2P_VIEWERS=8
WEBRTC_STREAM_MAX_VIDEO_BITRATE_KBPS=16000
WEBRTC_STREAM_MAX_AUDIO_BITRATE_KBPS=320

# Browser ICE configuration, served to authorized clients through
# GET /api/v1/webrtc/config. Changing these requires only a backend restart,
# not a frontend rebuild.
WEBRTC_CLIENT_ICE_SERVERS=
WEBRTC_CLIENT_ICE_USERNAME=
WEBRTC_CLIENT_ICE_CREDENTIAL=

# ICE configuration for the backend's own Pion sessions (voice/stream SFU).
# Leave empty on standard public deployments: the backend publishes host
# candidates directly via WEBRTC_PUBLIC_IP and its UDP ports, so no TURN
# relay allocations are created per session.
WEBRTC_SERVER_ICE_SERVERS=
WEBRTC_SERVER_ICE_USERNAME=
WEBRTC_SERVER_ICE_CREDENTIAL=

# Legacy fallbacks: when the split CLIENT/SERVER variables above are unset,
# these values are used for BOTH browser clients and backend Pion sessions.
# Prefer the split variables; this block exists for older deployments.
WEBRTC_ICE_SERVERS=
WEBRTC_ICE_USERNAME=
WEBRTC_ICE_CREDENTIAL=

# Local disk for private channel recordings (native attachment downloads).
# Keep this inside a persistent data volume. No server-side transcoding.
RECORDING_DIRECTORY=data/recordings
# Server copies up to 2 GiB each; default total of reserved + ready files (6 GiB).
# The instance owner can override it in the server settings (1 GiB - 1 TiB).
RECORDING_STORAGE_QUOTA_BYTES=6442450944
# Shared download bandwidth budget, independent from live WebRTC (2 MiB/s).
RECORDING_DOWNLOAD_BYTES_PER_SECOND=2097152

# Optional diagnostics on a separate loopback listener; disabled when empty.
# Explicit loopback IP required. Never publish this port through the reverse proxy.
DIAGNOSTICS_LISTEN_ADDR=

# Message attachments use the same persistent data volume as recordings.
# The owner allocates images/files/recordings through instance storage settings.
ATTACHMENT_DIRECTORY=data/attachments

# Personal/group WebRTC call signaling has its own bounded per-IP budget.
CALL_SIGNAL_RATE_LIMIT_RPS=120
CALL_SIGNAL_RATE_LIMIT_BURST=240
